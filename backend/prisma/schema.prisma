  results PredictionResult[]
}

model PredictionResult {
  id              String          @id @default(uuid()) @db.Uuid
  modelId         String          @db.Uuid
  model           PredictionModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  targetArea      Json? // GeoJSON Polygon target
  predictionType  String
  confidenceScore Decimal         @db.Decimal(5, 2)
  payload         Json
  forecastTime    DateTime

  // Standard enterprise audits
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?
  version   Int       @default(1)

  histories PredictionHistory[]
}

model PredictionHistory {
